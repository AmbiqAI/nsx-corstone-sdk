MEMORY {
    ITCM (rx) : ORIGIN = 0x10000000, LENGTH = 512K
    DTCM (rw) : ORIGIN = 0x30000000, LENGTH = 512K
    NPU_SRAM (rw) : ORIGIN = 0x31000000, LENGTH = 2M
    DDR (r) : ORIGIN = 0x70000000, LENGTH = 256M
}
REGION_ALIAS("BOOT", ITCM);
REGION_ALIAS("CODE", ITCM);
REGION_ALIAS("DATA", DTCM);
