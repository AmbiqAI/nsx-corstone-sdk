include_guard(GLOBAL)
function(nsx_assert_bsp_contract_supported)
    cmake_parse_arguments(PARSE_ARGV 0 BSP "" "SOC;CONTRACT" "")
    if(BSP_UNPARSED_ARGUMENTS OR BSP_KEYWORDS_MISSING_VALUES OR
       NOT BSP_SOC MATCHES "^(corstone300|corstone320)$" OR NOT BSP_CONTRACT STREQUAL "2")
        message(FATAL_ERROR "Unsupported Corstone BSP contract ${BSP_CONTRACT} for '${BSP_SOC}'")
    endif()
endfunction()

function(nsx_validate_bsp out_target)
    if(NOT TARGET nsx::bsp)
        message(FATAL_ERROR "Expected the selected Corstone BSP to register nsx::bsp")
    endif()
    get_target_property(provider nsx::bsp ALIASED_TARGET)
    if(NOT provider OR NOT "${NSX_BSP_CONTRACT_REQUIRED}" STREQUAL "2")
        message(FATAL_ERROR "Corstone requires an explicit BSP contract 2 provider")
    endif()
    get_target_property(version ${provider} NSX_BSP_CONTRACT_VERSION)
    nsx_assert_bsp_contract_supported(SOC "${NSX_SOC_FAMILY}" CONTRACT "${version}")
    foreach(cap DEBUG_ITM DEBUG_UART)
        get_target_property(value ${provider} NSX_BSP_${cap})
        if(NOT "${value}" MATCHES "^[01]$")
            message(FATAL_ERROR "BSP capability ${cap} must be 0 or 1")
        endif()
    endforeach()
    set(${out_target} "${provider}" PARENT_SCOPE)
endfunction()

function(nsx_register_bsp)
    cmake_parse_arguments(PARSE_ARGV 0 BSP "" "TARGET;CONTRACT;DEBUG_ITM;DEBUG_UART" "")
    if(BSP_UNPARSED_ARGUMENTS OR BSP_KEYWORDS_MISSING_VALUES OR NOT TARGET "${BSP_TARGET}")
        message(FATAL_ERROR "Invalid BSP registration")
    endif()
    get_target_property(alias ${BSP_TARGET} ALIASED_TARGET)
    if(alias OR TARGET nsx::bsp)
        message(FATAL_ERROR "The BSP must register one concrete target")
    endif()
    set_target_properties(${BSP_TARGET} PROPERTIES NSX_BSP_CONTRACT_VERSION "${BSP_CONTRACT}"
        NSX_BSP_DEBUG_ITM "${BSP_DEBUG_ITM}" NSX_BSP_DEBUG_UART "${BSP_DEBUG_UART}")
    add_library(nsx::bsp ALIAS ${BSP_TARGET})
    nsx_validate_bsp(provider)
endfunction()
